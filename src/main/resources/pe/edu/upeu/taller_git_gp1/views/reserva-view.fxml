<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
     fx:controller="pe.edu.upeu.taller_git_gp1.controller.ReservaController"
      spacing="12.0" styleClass="content-area">
    <padding><Insets top="22.0" right="25.0" bottom="22.0" left="25.0"/></padding>
    <children>
        <Label text="Gestión de reservas" styleClass="view-title"/>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Registre y consulte las estadías de los huéspedes." textFill="#666666"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#handleRefresh"/>
                <Button text="Nueva reserva" onAction="#handleNew" styleClass="button-login"/>
                <Button text="Editar" onAction="#handleEdit" styleClass="button-action-edit"/>
                <Button text="Eliminar" onAction="#handleDelete" styleClass="button-action-delete"/>
            </children>
        </HBox>
        <TableView fx:id="tableReserva" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150.0"/>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="100.0"/>
                <TableColumn fx:id="colHabitacion" text="Habitación" prefWidth="95.0"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="115.0"/>
                <TableColumn fx:id="colEntrada" text="Fecha entrada" prefWidth="115.0"/>
                <TableColumn fx:id="colSalida" text="Fecha salida" prefWidth="115.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110.0"/>
            </columns>
        </TableView>
    </children>
</VBox>
