<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ClienteController"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="content-area">
    <padding><Insets top="22.0" right="25.0" bottom="22.0" left="25.0"/></padding>
    <children>
        <Label text="Gestión de clientes" styleClass="view-title"/>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtBuscar" promptText="Buscar por número de documento" HBox.hgrow="ALWAYS"/>
                <Button text="Buscar" onAction="#handleSearch" styleClass="button-action"/>
                <Button text="Limpiar" onAction="#handleClear"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nuevo cliente" onAction="#handleNew" styleClass="button-login"/>
                <Button text="Editar" onAction="#handleEdit" styleClass="button-action-edit"/>
                <Button text="Eliminar" onAction="#handleDelete" styleClass="button-action-delete"/>
            </children>
        </HBox>
        <TableView fx:id="tableCliente" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="55.0"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150.0"/>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="110.0"/>
                <TableColumn fx:id="colCorreo" text="Correo electrónico" prefWidth="210.0"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0"/>
            </columns>
        </TableView>
    </children>
</VBox>
