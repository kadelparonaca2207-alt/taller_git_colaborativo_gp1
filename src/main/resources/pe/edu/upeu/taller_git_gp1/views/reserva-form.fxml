<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      stylesheets="@style.css" fx:controller="pe.edu.upeu.taller_git_gp1.controller.ReservaFormController"
      spacing="14.0" prefWidth="470.0" styleClass="form-pane">
    <padding><Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/></padding>
    <children>
        <Label fx:id="lblTitulo" text="Nueva reserva" styleClass="view-title"/>
        <GridPane hgap="12.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="120.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <children>
                <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCliente" promptText="Seleccione cliente" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Habitación:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbHabitacion" promptText="Seleccione habitación" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Fecha entrada:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFechaEntrada" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Fecha salida:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFechaSalida" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Estado:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbEstado" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </children>
        </GridPane>
        <Label text="La fecha de salida debe ser posterior a la fecha de entrada. Una habitación no puede tener reservas superpuestas." wrapText="true" textFill="#666666"/>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Cancelar" onAction="#handleCancel"/>
                <Button text="Guardar" onAction="#handleSave" styleClass="button-login"/>
            </children>
        </HBox>
    </children>
</VBox>
