<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx" stylesheets="@style.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.taller_git_gp1.controller.MainController"
            prefHeight="600.0" prefWidth="900.0">
    <!--HEADER-->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header" BorderPane.alignment="CENTER">
            <children>
                <Label text="HOTEL KAF" textFill="#4b0082">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                    <HBox.margin>
                        <Insets left="10.0"/>
                    </HBox.margin>
                </Label>
                <Label text="Servicio de hotelería" textFill="#666666">
                    <HBox.margin>
                        <Insets left="10.0"/>
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Bienvenido, Usuario" textFill="4b0082" fx:id="lblUsuario">
                    <font>
                        <Font name="System Italic" size="14.0"/>
                    </font>
                    <HBox.margin>
                        <Insets right="20.0"/>
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </top>

    <!--MENU LATERAL-->
    <left>
        <VBox prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showHome" styleClass="nav-button"
                        text="Inicio"/>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showCliente" styleClass="nav-button"
                        text="Clientes"/>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showHabitaciones" styleClass="nav-button"
                        text="Habitaciones"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-button"
                        style="-fx-text-fill: #ffd700"
                        text="Cerrar Sesión"/>
            </children>
        </VBox>
    </left>
    <center>
        <VBox BorderPane.alignment="CENTER">
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS">
                <children>
                    <Label text="Seleccione una opción del Menu" textFill="#999999"/>
                </children>
            </StackPane>
            <HBox alignment="CENTER" prefHeight="20.0">
                <children>
                    <Label text="©Copyright KAS-2026"
                           textFill="#999999"/>
                </children>
            </HBox>
        </VBox>
    </center>
</BorderPane>
