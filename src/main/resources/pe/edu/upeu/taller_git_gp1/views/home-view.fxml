<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane fx:id="mainContainer" style="-fx-background-color: #F7F7F7"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <children>
        <VBox alignment="CENTER" spacing="30.0">
            <children>
                <Label text="Bienvenido al sistema de Gestion Hotelera" textFill="#014074">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>
                <ImageView fx:id="imgHotel"
                           fitHeight="620.0"
                           fitWidth="1100.0"
                           pickOnBounds="true"
                           preserveRatio="true"
                           smooth="true">

                    <image>
                        <Image url="@../IMG/Hotel_KAS.png"/>
                    </image>

                </ImageView>


            </children>

        </VBox>

    </children>

</StackPane>
